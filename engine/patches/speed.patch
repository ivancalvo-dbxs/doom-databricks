diff --git a/src/i_timer.c b/src/i_timer.c
index 4ec6fb0..7a1b09b 100644
--- a/src/i_timer.c
+++ b/src/i_timer.c
@@ -28,11 +28,35 @@
 
 static Uint32 basetime = 0;
 
+// Agent clock: game time = wall time * speed, frozen while paused.
+// Deltas are clamped so a hidden tab does not fast-forward the game.
+int agent_speed = 1;
+int agent_paused = 0;
+static double agent_ms = 0;
+static Uint32 agent_last = 0;
+
+static Uint32 AgentTicks(void)
+{
+    Uint32 now = SDL_GetTicks();
+    Uint32 dt = now - agent_last;
+
+    agent_last = now;
+    if (dt > 100)
+    {
+        dt = 100;
+    }
+    if (!agent_paused)
+    {
+        agent_ms += (double) dt * agent_speed;
+    }
+    return (Uint32) agent_ms;
+}
+
 int  I_GetTime (void)
 {
     Uint32 ticks;
 
-    ticks = SDL_GetTicks();
+    ticks = AgentTicks();
 
     if (basetime == 0)
         basetime = ticks;
@@ -50,7 +74,7 @@ int I_GetTimeMS(void)
 {
     Uint32 ticks;
 
-    ticks = SDL_GetTicks();
+    ticks = AgentTicks();
 
     if (basetime == 0)
         basetime = ticks;
